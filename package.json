{
  "name": "@pinarkive/pinarkive-cli",
  "version": "1.0.3",
  "description": "Command-line interface for the Pinarkive API v3",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "pinarkive": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/cli.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pinarkive",
    "ipfs",
    "cli",
    "pin"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@pinarkive/pinarkive-sdk-ts": "^3.1.5",
    "axios": "^1.6.2",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "degit": "^3.8.0",
    "inquirer": "^14.2.0",
    "open": "^11.0.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.19.0",
    "eslint": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
